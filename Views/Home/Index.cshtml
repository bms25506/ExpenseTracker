@model ExpenseTracker.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Expense Dashboard</h1>
        <p class="text-muted mb-0">
            A quick overview of your income, expenses, and recent activity.
        </p>
    </div>

    <a asp-controller="Transactions"
       asp-action="Create"
       class="btn btn-primary">
        Add Transaction
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Total Income</h5>

                <p class="card-text fs-3 text-success mb-0">
                    @Model.TotalIncome.ToString("C")
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Total Expenses</h5>

                <p class="card-text fs-3 text-danger mb-0">
                    @Model.TotalExpenses.ToString("C")
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Balance</h5>

                <p class="card-text fs-3 mb-0">
                    @Model.Balance.ToString("C")
                </p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Recent Transactions</h2>

    <a asp-controller="Transactions"
       asp-action="Index"
       class="btn btn-outline-secondary">
        View All Transactions
    </a>
</div>

@if (!Model.RecentTransactions.Any())
{
    <div class="alert alert-info">
        No transactions have been added yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var transaction in Model.RecentTransactions)
                {
                    <tr>
                        <td>
                            @transaction.Date.ToString("MM/dd/yyyy")
                        </td>

                        <td>
                            @transaction.Description
                        </td>

                        <td>
                            @transaction.Category?.Name
                        </td>

                        <td>
                            @transaction.Category?.Type
                        </td>

                        <td class="text-end">
                            @transaction.Amount.ToString("C")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}