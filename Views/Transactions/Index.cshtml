@model ExpenseTracker.ViewModels.TransactionIndexViewModel

@{
    ViewData["Title"] = "Transactions";

    var filtersAreActive =
        !string.IsNullOrWhiteSpace(Model.SearchTerm) ||
        Model.CategoryId.HasValue ||
        Model.StartDate.HasValue ||
        Model.EndDate.HasValue;

    var balanceTextClass =
        Model.Balance >= 0
            ? "text-success"
            : "text-danger";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Transactions</h1>

    <a asp-controller="Transactions"
       asp-action="Create"
       class="btn btn-primary">
        Add Transaction
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Filtered Income</h5>

                <p class="card-text fs-3 text-success mb-0">
                    @Model.TotalIncome.ToString("C")
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Filtered Expenses</h5>

                <p class="card-text fs-3 text-danger mb-0">
                    @Model.TotalExpenses.ToString("C")
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Filtered Balance</h5>

                <p class="card-text fs-3 @balanceTextClass mb-0">
                    @Model.Balance.ToString("C")
                </p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Search & Filter</h5>

        <form asp-controller="Transactions"
              asp-action="Index"
              method="get">

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="SearchTerm"
                           class="form-label">
                        Description
                    </label>

                    <input asp-for="SearchTerm"
                           class="form-control"
                           placeholder="Search descriptions..." />
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoryId"
                           class="form-label">
                        Category
                    </label>

                    <select asp-for="CategoryId"
                            asp-items="Model.Categories"
                            class="form-select">
                        <option value="">All Categories</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="StartDate"
                           class="form-label">
                        Start Date
                    </label>

                    <input asp-for="StartDate"
                           class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="EndDate"
                           class="form-label">
                        End Date
                    </label>

                    <input asp-for="EndDate"
                           class="form-control" />

                    <span asp-validation-for="EndDate"
                          class="text-danger">
                    </span>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit"
                        class="btn btn-primary">
                    Apply Filters
                </button>

                <a asp-controller="Transactions"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Clear Filters
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Transactions.Any())
{
    if (filtersAreActive)
    {
        <div class="alert alert-info">
            No transactions match the current filters.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No transactions have been added yet.
        </div>
    }
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th class="text-end">Amount</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var transaction in Model.Transactions)
                {
                    <tr>
                        <td>
                            @transaction.Date.ToString("MM/dd/yyyy")
                        </td>

                        <td>
                            @transaction.Description
                        </td>

                        <td>
                            @transaction.Category?.Name
                        </td>

                        <td>
                            @transaction.Category?.Type
                        </td>

                        <td class="text-end">
                            @transaction.Amount.ToString("C")
                        </td>

                        <td>
                            <a asp-controller="Transactions"
                               asp-action="Edit"
                               asp-route-id="@transaction.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-controller="Transactions"
                               asp-action="Delete"
                               asp-route-id="@transaction.Id"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}