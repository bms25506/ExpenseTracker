@model ExpenseTracker.Models.Transaction

@{
    ViewData["Title"] = "Delete Transaction";
}

<h1>Delete Transaction</h1>

<hr />

<div class="alert alert-warning">
    <strong>Warning:</strong>
    Are you sure you want to delete this transaction?
</div>

<dl class="row">
    <dt class="col-sm-2">
        Description
    </dt>
    <dd class="col-sm-10">
        @Model.Description
    </dd>

    <dt class="col-sm-2">
        Date
    </dt>
    <dd class="col-sm-10">
        @Model.Date.ToString("MM/dd/yyyy")
    </dd>

    <dt class="col-sm-2">
        Category
    </dt>
    <dd class="col-sm-10">
        @Model.Category?.Name
    </dd>

    <dt class="col-sm-2">
        Type
    </dt>
    <dd class="col-sm-10">
        @Model.Category?.Type
    </dd>

    <dt class="col-sm-2">
        Amount
    </dt>
    <dd class="col-sm-10">
        @Model.Amount.ToString("C")
    </dd>
</dl>

<form asp-action="Delete"
      asp-route-id="@Model.Id"
      method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>